{
  "description": "HTTP JSON events are mapped and reach the log sink with exact field values",
  "requires": [],
  "extensions": [],
  "ports": [8201],
  "apps": ["app.siddhi"],
  "steps": [
    { "type": "http-post", "url": "http://localhost:8201/HttpPassThrough/InputStream", "body": { "symbol": "AAPL-{{runId}}", "price": 150.25, "volume": 1000 } },
    { "type": "http-post", "url": "http://localhost:8201/HttpPassThrough/InputStream", "body": { "symbol": "GOOG-{{runId}}", "price": 2800.5, "volume": 500 } },
    { "type": "http-post", "url": "http://localhost:8201/HttpPassThrough/InputStream", "body": { "symbol": "IBM-{{runId}}", "price": 101.75, "volume": 200 } },
    { "type": "expect-log", "name": "AAPL mapped with exact fields", "pattern": "\\[http-pass-through\\] : Event\\{.*data=\\[AAPL-{{runId}}, 150\\.25, 1000\\]" },
    { "type": "expect-log", "name": "GOOG mapped with exact fields", "pattern": "\\[http-pass-through\\] : Event\\{.*data=\\[GOOG-{{runId}}, 2800\\.5, 500\\]" },
    { "type": "expect-log", "name": "IBM mapped with exact fields", "pattern": "\\[http-pass-through\\] : Event\\{.*data=\\[IBM-{{runId}}, 101\\.75, 200\\]" }
  ]
}
